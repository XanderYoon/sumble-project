# Ignore hidden files and directories by default.
.*
!.gitignore
!.agents/
!.agents/skills/
!.agents/skills/agentic-sdlc/

# Python artifacts
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/

# Downloaded package archive (the unpacked skill is canonical)
agentic-sdlc.tar.gz
.worktrees/
.sdlc/handoffs/
.sdlc/runs/
.sdlc/.lock
.pytest_cache/
.ruff_cache/

# Keep workflow documents and container build exclusions in the base checkout.
!.sdlc/
!.sdlc/**
!.dockerignore
.sdlc/.lock
.sdlc/handoffs/
.sdlc/runs/
*.log
